# Model routing — single source of truth for all Hermes agents
# Primary: ternary-bonsai-2-27b:q2_0 (Ternary-Bonsai-2-27B, Q2_0 2-bit ternary, ~7.6GB)
#          Imported from prism-ml/Ternary-Bonsai-2-27B-gguf (base: Qwen/Qwen3.8-27B) into Ollama
#          served locally via Ollama on :11434, proxied to :8555 for Hermes compatibility (ops/bin/gemma-server.sh)
# Fallback: same model on same endpoint (unified fleet — see docs/ops/model-policy.md)
# Retired 2026-09-18: 0bserverx/Qwen3.8-27B-Heretic-Abliterated-Uncensored-GGUF (llama.cpp :8555) — rollback only
# Retired 2026-09-18: AtomicChat/atomic-chat-gemma412-IQ4_XS @1337 (rollback only)
# Retired 2026-11-03: gemma4:12b (Q4_K_M ~8GB, Ollama) — rollback only
#
# All run-* scripts and hermes profiles must read this file.
# DO NOT hardcode model names elsewhere — source this file instead.
# Last updated: 2026-11-03 — locked to ternary-bonsai-2-27b:q2_0 (:8555 via Ollama proxy)

# Primary (Ollama via proxy on :8555)
PRIMARY_MODEL_ID=ternary-bonsai-2-27b:q2_0
PRIMARY_MODEL_HF=prism-ml/Ternary-Bonsai-2-27B-gguf
PRIMARY_BASE_URL=http://127.0.0.1:8555/v1
# Context 65536 = fleet standard; Bonsai-2-27B native context set to 65536 in the Modelfile.
PRIMARY_CTX=65536

# Fallback (same model — unified fleet, only used if primary fails)
FALLBACK_MODEL_ID=ternary-bonsai-2-27b:q2_0
FALLBACK_BASE_URL=http://127.0.0.1:8555/v1

# Unified check helper
#   ops/bin/model-check.sh $PRIMARY_BASE_URL $PRIMARY_MODEL_ID --completion
#   ops/bin/model-check.sh $FALLBACK_BASE_URL $FALLBACK_MODEL_ID --completion
