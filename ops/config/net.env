HERMES_GW_URL=http://127.0.0.1:8642
HERMES_DASH_URL_LOCAL=http://127.0.0.1:9119
WORKSPACE_URL=http://127.0.0.1:3001
TWENTY_URL=http://127.0.0.1:3000
TWENTY_STAGING_URL=http://127.0.0.1:3100
BUZZ_RELAY_URL=http://localhost:3010
