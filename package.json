{
  "name": "hermes-workspace",
  "version": "2.0.0",
  "description": "Desktop workspace for Hermes Agent — chat, orchestration, and multi-agent coding pipelines",
  "author": "Eric (https://github.com/outsourc-e)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=2048\" vite dev",
    "build": "vite build",
    "start:all": "concurrently \"hermes gateway run\" \"pnpm dev\"",
    "start": "NODE_OPTIONS=\"--max-old-space-size=2048\" node .output/server/index.mjs",
    "start:dev": "NODE_OPTIONS=\"--max-old-space-size=2048\" vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:adversarial": "vitest run tests/adversarial",
    "test:compliance": "vitest run tests/compliance",
    "test:perf": "vitest run tests/unit/perf-budget.test.ts",
    "test:all": "vitest run --coverage",
    "test:live": "vitest run tests/live --reporter=verbose",
    "test:ops": "bash ops/tests/run-all.sh",
    "nano:check": "node scripts/check-nano.mjs",
    "nano:launch": "bash scripts/launch-chrome-nano.sh",
    "nano:check:live": "node --loader tsx scripts/check-nano-live.mjs 2>&1 || echo 'Run in Chrome with flags: chrome://on-device-internals must show available'",
    "dev:chrome": "bash scripts/launch-chrome-nano.sh",
    "sbom": "npx @cyclonedx/cyclonedx-npm --output-file sbom.cyclonedx.json --output-format json",
    "smoke:managed": "node scripts/managed-companion-smoke.mjs",
    "smoke:operations": "node scripts/operations-smoke.mjs",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project=chromium-m2max"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@lobehub/icons": "^5.0.1",
    "@lobehub/icons-static-png": "^1.83.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@types/react-grid-layout": "^1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "marked": "^17.0.1",
    "motion": "^12.29.2",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^2.9.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^6.0.2",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@ai-protect/core": "workspace:*",
    "@ai-protect/nano": "workspace:*",
    "@ai-protect/policy": "workspace:*",
    "@ai-protect/shared": "workspace:*",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/chrome": "^0.2.9",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "chrome-devtools-mcp": "^1.9.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.2.0",
    "fast-check": "^4.10.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
