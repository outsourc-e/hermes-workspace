{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.ts"
  ],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "chrome", "dom-chromium-ai"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ai-protect/shared": ["./packages/ai-protect-shared/src/index.ts"],
      "@ai-protect/shared/*": ["./packages/ai-protect-shared/src/*"],
      "@ai-protect/core": ["./packages/ai-protect-core/src/index.ts"],
      "@ai-protect/core/*": ["./packages/ai-protect-core/src/*"],
      "@ai-protect/nano": ["./packages/ai-protect-nano/src/index.ts"],
      "@ai-protect/nano/*": ["./packages/ai-protect-nano/src/*"],
      "@ai-protect/policy": ["./packages/ai-protect-policy/src/index.ts"],
      "@ai-protect/policy/*": ["./packages/ai-protect-policy/src/*"]
    }
  }
}
